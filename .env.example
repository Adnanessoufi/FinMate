# Optional live agent. Without a key, FinMate uses its offline planner.
OPENAI_API_KEY=
FINMATE_MODEL=gpt-5.6-terra

# Optional OpenAI-compatible provider:
# FINMATE_BASE_URL=
# FINMATE_API_KEY=

# Required on Vercel. A fixed 64-character hexadecimal key encrypts saved sessions.
# Locally, omitting it creates a key in data/sessions.json.key. Keep that key.
# FINMATE_STORAGE_KEY=
# DATABASE_URL=

# Optional hosted settings:
# FINMATE_PUBLIC_ORIGIN=https://finmate.example.com
# FINMATE_DAILY_AGENT_LIMIT=100

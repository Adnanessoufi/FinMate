# Optional live agent. Without a key, the offline planner remains usable.
OPENAI_API_KEY=
FINMATE_MODEL=gpt-5.6-terra
# Optional OpenAI-compatible provider overrides:
# FINMATE_BASE_URL=
# FINMATE_API_KEY=

# Optional: supply a separate 32-byte vault key as 64 hexadecimal characters.
# Keep the original key to retain access to existing saved accounts.
# If omitted, a local development key is generated in data/sessions.json.key.
# FINMATE_STORAGE_KEY=

# Vercel: use a pooled PostgreSQL connection and a fixed vault key.
# DATABASE_URL=
# FINMATE_STORAGE_KEY=
# Optional custom domain, for example https://finmate.example.com:
# FINMATE_PUBLIC_ORIGIN=
# Hosted model-request budget per 24-hour window (default 100):
# FINMATE_DAILY_AGENT_LIMIT=100
